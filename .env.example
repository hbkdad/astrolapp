# Copy to .env and fill in. NEVER commit .env or any real secret.
#
# Nothing here is required by the current codebase: the calculation engines are
# pure and need no configuration. These are placeholders for the application
# layers described in docs/PROJECT_STATUS.md, listed now so that secrets have a
# documented home from the start rather than being invented ad hoc later.

# --- Database (not yet implemented) ---
DATABASE_URL=postgresql://user:password@localhost:5432/astrolapp

# --- Authentication (not yet implemented) ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- AI interpretation layer (optional by design) ---
# The product must remain fully functional with this unset; the interpretation
# engine falls back to deterministic templates.
ANTHROPIC_API_KEY=

# --- Payments (not yet implemented) ---
# Entitlements are always resolved server-side. Never trust client plan state.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observability (not yet implemented) ---
# Never log secrets, exact birth times, birth locations or private profile names.
SENTRY_DSN=
